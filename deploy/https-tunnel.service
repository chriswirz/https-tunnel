# systemd unit for the https-tunnel server.
#
# Install:
#   sudo install -m 0755 https-tunnel-linux-amd64 /usr/local/bin/https-tunnel
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin https-tunnel
#   sudo install -d -o https-tunnel -g https-tunnel /etc/https-tunnel /var/lib/https-tunnel
#   https-tunnel --example-config | sudo tee /etc/https-tunnel/config.json >/dev/null
#   sudo chown https-tunnel:https-tunnel /etc/https-tunnel/config.json
#   sudo chmod 600 /etc/https-tunnel/config.json
#   sudo $EDITOR /etc/https-tunnel/config.json     # enable the server section
#   sudo install -m 0644 deploy/https-tunnel.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now https-tunnel
#
# The service writes to its own config file when the administrator password is
# changed from the web UI, so /etc/https-tunnel must stay writable by this user.

[Unit]
Description=https-tunnel server
Documentation=https://github.com/chriswirz/https-tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=https-tunnel
Group=https-tunnel
ExecStart=/usr/local/bin/https-tunnel --config /etc/https-tunnel/config.json server
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2

# Both directories are created and chowned to this unit's user by systemd.
StateDirectory=https-tunnel
StateDirectoryMode=0700
ConfigurationDirectory=https-tunnel
ConfigurationDirectoryMode=0750

# The process listens on an unprivileged port with nginx in front, so it needs
# no capabilities at all. Drop AmbientCapabilities and add
# CAP_NET_BIND_SERVICE only if you point it straight at 443.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

# Session state, and the config file the password hash is written back into.
ReadWritePaths=/var/lib/https-tunnel /etc/https-tunnel

# Journal only; the binary logs structured lines to stderr.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
